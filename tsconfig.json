{
	"compilerOptions": {
		"module": "es2022",
		"moduleResolution": "bundler",
		"declaration": true,
		"emitDeclarationOnly": true,
		"removeComments": false,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"target": "es2022",
		"lib": ["es2022", "dom", "dom.iterable"],
		"outDir": "out",
		"incremental": true,
		"esModuleInterop": true,
		"strict": true,
		"sourceMap": false,
		"allowJs": true,
		"types": ["obsidian-typings", "monaco-editor", "./source/types/workers.d.ts"],
		"paths": {
			"@main": ["./source/main.ts"],
			"@settings/*": ["./source/settings/*"],
			"@settings-ui/*": ["./source/settings/tabs/factory/ui/*"],
			"@settings-factory/*": ["./source/settings/tabs/factory/*"],
			"@compat/main": ["source/compat/main.ts"],
			"@compat/*": ["source/compat/*"]
		}
	},
	"exclude": ["node_modules", "out", "git", "venv", "scripts/**"],
	"include": ["**/*.ts", "**/*.d.ts"]
}
