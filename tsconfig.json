{
	"compilerOptions": {
		"module": "es2022",
		"moduleResolution": "bundler",
		"declaration": false,
		"removeComments": false,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"downlevelIteration": true,
		"target": "es2022",
		"lib": ["es2022", "dom", "dom.iterable"],
		"outDir": "out",
		"incremental": true,
		"esModuleInterop": true,
		"strict": true,
		"sourceMap": false,
		"allowJs": true,
		"types": ["obsidian-typings", "monaco-editor", "./source/types/workers.d.ts"],
		"paths": {
			"@main": ["./source/main.ts"],
			"@settings/*": ["./source/settings/*"]
		}
	},
	"exclude": ["node_modules", "out", "git", "venv"],
	"include": ["**/*.ts", "**/*.d.ts"]
}
