{
	"type": "module",
	"scripts": {
		"test:compat": "node --import tsx ./node_modules/mocha/bin/mocha.js --config compat/.mocharc.json compat/**/*.spec.ts",
		"test:compat:unit": "node --import tsx ./node_modules/mocha/bin/mocha.js --config compat/.mocharc.json compat/compat.spec.ts",
		"test:compat:integration": "node --import tsx ./node_modules/mocha/bin/mocha.js --config compat/.mocharc.json compat/integration.spec.ts",
		"test:watch": "node --import tsx ./node_modules/mocha/bin/mocha.js --config compat/.mocharc.json --watch compat/**/*.spec.ts",
		"test:coverage": "npx nyc node --import tsx ./node_modules/mocha/bin/mocha.js --config compat/.mocharc.json compat/**/*.spec.ts",
		"test:generate-parsed": "tsx compat/gen.ts"
	},
	"dependencies": {
		"chai": "^6.2.2",
		"chalk": "^5.6.2",
		"mocha": "^11.7.5",
		"tsx": "^4.20.6"
	},
	"devDependencies": {
		"@types/chai": "^5.2.3",
		"@types/chalk": "^0.4.31",
		"@types/mocha": "^10.0.10"
	}
}
