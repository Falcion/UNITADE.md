{
	"compilerOptions": {
		"module": "es2022",
		"moduleResolution": "bundler",
		"declaration": true,
		"emitDeclarationOnly": true,
		"removeComments": false,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"target": "es2022",
		"lib": ["es2022", "dom", "dom.iterable"],
		"outDir": "out",
		"incremental": true,
		"esModuleInterop": true,
		"strict": true,
		"sourceMap": false,
		"allowJs": true,
		"types": ["mocha", "chai"]
	},
	"exclude": ["node_modules", "out", "git", "venv", "scripts/**"],
	"include": ["tests/**/*.spec.ts"]
}
